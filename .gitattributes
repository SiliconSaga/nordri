# Normalize all text files to LF in the index *and* the working tree, so the
# repo — not each machine's core.autocrlf — is authoritative. Everything here is
# already stored LF; this stops Windows checkouts from smudging to CRLF and then
# showing perpetually-"modified" files. Binary files are auto-detected and left
# untouched.
* text=auto eol=lf

# Shell scripts and the sourced lib/ must stay LF: bash (including Git Bash /
# MSYS2 on Windows) fails to source or run scripts that carry CRLF line endings.
# Without this, core.autocrlf=true converts *.sh to CRLF on checkout and breaks
# bootstrap.sh / update-embedded-git.sh and everything they source from lib/.
*.sh text eol=lf
